#!/bin/sh
# Exits 0 when Postfix's master process runs and port 25 completes an SMTP
# handshake (220 banner, 250 reply to EHLO, 221 reply to QUIT). With
# --backend, the LMTP backend must also answer LHLO with 250.
set -u

TMP="$(mktemp -d)" || exit 1
trap 'exec 3>&- 2>/dev/null; kill "$NC_PID" 2>/dev/null; rm -rf "$TMP"' EXIT
NC_PID=""

fail() {
  printf 'postfix-edge-healthcheck: %s\n' "$*" >&2
  exit 1
}

# Waits up to five seconds for a line starting with the code and a space.
expect() {
  i=0
  while [ "$i" -lt 50 ]; do
    if grep -q "^$1 " "$TMP/out" 2>/dev/null; then
      return 0
    fi
    sleep 0.1
    i=$((i + 1))
  done
  return 1
}

# converse <host> <port> <greeting verb>: one session, each command sent only
# after the reply to the previous one has arrived.
converse() {
  : >"$TMP/out"
  rm -f "$TMP/in"
  mkfifo "$TMP/in"
  nc -w 5 "$1" "$2" <"$TMP/in" >"$TMP/out" 2>/dev/null &
  NC_PID=$!
  exec 3>"$TMP/in"
  expect 220 || return 1
  printf '%s healthcheck.invalid\r\n' "$3" >&3
  expect 250 || return 1
  printf 'QUIT\r\n' >&3
  expect 221 || return 1
  exec 3>&-
  wait "$NC_PID" 2>/dev/null
  NC_PID=""
  return 0
}

backend=no
case "${1:-}" in
  '') ;;
  --backend) backend=yes ;;
  *) fail "usage: postfix-edge-healthcheck [--backend]" ;;
esac

postfix status >/dev/null 2>&1 || fail "the Postfix master process is not running"
converse 127.0.0.1 25 EHLO || fail "port 25 did not complete an SMTP handshake"

if [ "$backend" = yes ]; then
  target="$(postconf -h relay_transport)"
  target="${target#lmtp:}"
  case "$target" in
    inet:\[*\]:*) host="${target#inet:\[}"; host="${host%%\]:*}"; port="${target##*:}" ;;
    inet:*:*) host="${target#inet:}"; host="${host%:*}"; port="${target##*:}" ;;
    *) fail "--backend checks only an inet: LMTP target, not '${target}'" ;;
  esac
  converse "$host" "$port" LHLO || fail "the LMTP backend at ${host}:${port} did not answer LHLO"
fi
exit 0
