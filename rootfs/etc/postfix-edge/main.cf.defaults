# Applied by postfix-edge-entrypoint before the settings it derives from the
# environment and before any file in main.cf.d/, which can override these.

# Logging goes to the container's standard output.
maillog_file = /dev/stdout

# Mail is accepted only for relay_domains and handed to the LMTP backend;
# local delivery and delivery anywhere else are disabled.
inet_interfaces = all
mydestination =
local_recipient_maps =
local_transport = error:local delivery is disabled
default_transport = error:delivery outside the relay domains is disabled
alias_maps =
alias_database =
myorigin = $myhostname

# Only clients in mynetworks may send, and only to the relay domains
# themselves: relay_domains is left out of parent_domain_matches_subdomains,
# so a subdomain of a relay domain is not accepted.
parent_domain_matches_subdomains = debug_peer_list, fast_flush_domains, mynetworks, permit_mx_backup_networks, qmqpd_authorized_clients, smtpd_access_maps
smtpd_banner = $myhostname ESMTP
smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_sasl_auth_enable = no
smtpd_client_restrictions = permit_mynetworks, reject
smtpd_relay_restrictions = reject_unauth_destination
unverified_recipient_reject_code = 550

# STARTTLS, when the entrypoint enables it.
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_received_header = yes
smtpd_tls_loglevel = 1
biff = no
